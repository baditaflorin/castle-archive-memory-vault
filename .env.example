# All v1 build-time configuration. No runtime secrets — this is a Mode A project.
# Copy to .env.local for local development overrides.

# Public base path under which the app is served (defaults to /castle-archive-memory-vault/).
# Override if you fork to a different repo name or use a custom domain at root.
VITE_BASE=/castle-archive-memory-vault/

# Optional: override the Hugging Face model cache origin if you mirror models privately.
# VITE_TRANSFORMERS_REMOTE_HOST=https://huggingface.co
